<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.fitframework.integration.mybatis.mapper.WordMapper">
    <insert id="add" parameterType="org.fitframework.integration.mybatis.model.WordDo">
        INSERT INTO word (name, first_letter)
        VALUES (#{name}, #{firstLetter})
    </insert>
    <select id="get" resultType="org.fitframework.integration.mybatis.model.WordDo">
        select *
        from word
        where name = #{name}
    </select>
</mapper>